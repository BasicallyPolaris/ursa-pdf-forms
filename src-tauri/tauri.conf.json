{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ursa-pdf-forms",
  "version": "0.1.0",
  "identifier": "com.basicallypolaris.ursa-pdf-forms",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ursa PDF Forms",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "German"],
        "displayLanguageSelector": true
      }
    }
  }
}
